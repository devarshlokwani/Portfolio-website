# The site's own address, with no trailing slash. Fills in the canonical
# link, the Open Graph and Twitter tags in index.html, and the URLs in the
# generated sitemap.xml and robots.txt. On Vercel this can be left unset:
# the build falls back to the project's production hostname.
VITE_SITE_URL=http://localhost:5173

# Formspree (Contact form): the form ID from your Formspree endpoint URL.
# The only variable the shipped site actually needs.
VITE_FORMSPREE_ID=

# ---------------------------------------------------------------------------
# Not used yet. Sign the Wall is written but not wired into any page, so
# nothing below reaches the bundle and leaving it all blank changes nothing.
# Fill it in when that feature goes live.
# ---------------------------------------------------------------------------

# Firebase (Sign the Wall): from Firebase console > Project settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check: from Firebase console > App Check > reCAPTCHA v3
VITE_RECAPTCHA_SITE_KEY=
